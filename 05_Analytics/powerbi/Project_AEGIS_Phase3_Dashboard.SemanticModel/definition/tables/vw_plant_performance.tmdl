table vw_plant_performance
	lineageTag: bc9a9818-84e7-4f24-85e2-f9c4a62aae2e

	measure 'Fleet Heat Rate' = DIVIDE(SUM(vw_plant_performance[total_fuel_mmbtu])*1000000, SUM(vw_plant_performance[net_generation_mwh])*1000)
		formatString: #,0
		lineageTag: 08bd5a66-4567-4dfd-b4c9-97236b145aa1

	measure 'Active Plants' = DISTINCTCOUNT(vw_plant_performance[orispl_code])
		formatString: #,0
		lineageTag: ba659447-dddb-47d9-9636-0742878831c3

	measure 'Total Net Generation MWh' = SUM(vw_plant_performance[net_generation_mwh])
		formatString: #,0
		lineageTag: 86478171-bcb0-4f70-b7f8-4946ef376196

