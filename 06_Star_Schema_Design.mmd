erDiagram
    %% =========================================================================
    %% LOGITRACK DWBI - ENTERPRISE STAR SCHEMA
    %% Ralph Kimball Dimensional Modeling Architecture
    %% 3 Fact Tables (Transaction, Periodic Snapshot, Factless) + 9 Dimensions
    %% =========================================================================

    %% --- RELATIONSHIPS: FACT_DELIVERY_ATTEMPT (Transaction Fact) ---
    Dim_Date ||--o{ Fact_Delivery_Attempt : "Attempt_Date_Key"
    Dim_Date ||--o{ Fact_Delivery_Attempt : "SLA_Deadline_Date_Key"
    Dim_Hub ||--o{ Fact_Delivery_Attempt : "Origin_Hub_Key"
    Dim_Route ||--o{ Fact_Delivery_Attempt : "Route_Key"
    Dim_Rider ||--o{ Fact_Delivery_Attempt : "Rider_Key"
    Dim_Customer ||--o{ Fact_Delivery_Attempt : "Customer_Key"
    Dim_Service_Type ||--o{ Fact_Delivery_Attempt : "Service_Type_Key"
    Dim_Delivery_Status ||--o{ Fact_Delivery_Attempt : "Delivery_Status_Key"
    Dim_Parcel_Type ||--o{ Fact_Delivery_Attempt : "Parcel_Type_Key"

    %% --- RELATIONSHIPS: FACT_DAILY_HUB_BACKLOG (Periodic Snapshot Fact) ---
    Dim_Date ||--o{ Fact_Daily_Hub_Backlog : "Snapshot_Date_Key"
    Dim_Hub ||--o{ Fact_Daily_Hub_Backlog : "Hub_Key"
    Dim_Parcel_Type ||--o{ Fact_Daily_Hub_Backlog : "Parcel_Type_Key"

    %% --- RELATIONSHIPS: FACT_RIDER_ROUTE_ASSIGNMENT (Factless Fact) ---
    Dim_Date ||--o{ Fact_Rider_Route_Assignment : "Assignment_Date_Key"
    Dim_Rider ||--o{ Fact_Rider_Route_Assignment : "Rider_Key"
    Dim_Route ||--o{ Fact_Rider_Route_Assignment : "Route_Key"
    Dim_Hub ||--o{ Fact_Rider_Route_Assignment : "Hub_Key"
    Dim_Shift ||--o{ Fact_Rider_Route_Assignment : "Shift_Key"

    %% =========================================================================
    %% DIMENSION TABLES (9 Conformed Dimensions)
    %% =========================================================================

    Dim_Date {
        int Date_Key PK
        date Date_Value
        int Day_Of_Week_Number
        varchar_10 Day_Of_Week_Name
        int Day_Of_Month
        int Month_Number
        varchar_10 Month_Name
        int Quarter_Number
        varchar_2 Quarter_Name
        int Year
        varchar_7 Year_Month
        int Week_Of_Year_Number
        varchar_3 Is_Weekend_Flag
        varchar_3 Is_Working_Day_Flag
        varchar_3 Statutory_Holiday_Flag
        varchar_10 Fiscal_Period
    }

    Dim_Customer {
        int Customer_Key PK
        varchar_20 Customer_ID
        varchar_100 Company_Name
        varchar_80 Contact_Person
        varchar_100 Contact_Email
        varchar_30 Customer_Segment
        varchar_20 Contract_Tier
        decimal_12_2 Credit_Limit_Amount
        varchar_150 Billing_Street_Address
        varchar_50 City
        varchar_20 Postal_Code
        varchar_50 Region_Name
        date Effective_Date
        date Expiration_Date
        varchar_10 Current_Row_Indicator
    }

    Dim_Rider {
        int Rider_Key PK
        varchar_20 Rider_ID
        varchar_50 First_Name
        varchar_50 Last_Name
        varchar_25 Mobile_Phone
        varchar_30 Employment_Type
        varchar_25 Vehicle_Type
        varchar_25 Vehicle_Registration_No
        varchar_10 Home_Hub_Code
        varchar_50 Home_Region_Name
        decimal_3_2 Rating_Score
        date Hire_Date
        date Effective_Date
        date Expiration_Date
        varchar_10 Current_Row_Indicator
    }

    Dim_Hub {
        int Hub_Key PK
        varchar_10 Hub_Code
        varchar_80 Hub_Name
        varchar_40 Hub_Type
        int Maximum_Daily_Parcel_Capacity
        int Total_Dock_Doors_Count
        varchar_80 Hub_Manager_Name
        varchar_25 Contact_Phone
        varchar_150 Street_Address
        varchar_50 City
        varchar_20 Postal_Code
        varchar_50 Region_Name
        varchar_50 Country_Name
    }

    Dim_Route {
        int Route_Key PK
        varchar_10 Route_Code
        varchar_80 Route_Name
        varchar_10 Assigned_Hub_Code
        varchar_40 Zone_Classification
        varchar_50 City
        varchar_50 Region_Name
        int Target_Daily_Stops
        decimal_6_2 Average_Route_Distance_Km
        varchar_10 Risk_Level_Rating
    }

    Dim_Service_Type {
        int Service_Type_Key PK
        varchar_10 Service_Code
        varchar_50 Service_Tier_Name
        int Guaranteed_Delivery_Hours
        decimal_8_2 Base_Flat_Fee
        decimal_5_2 Fuel_Surcharge_Rate_Pct
        varchar_3 Weekend_Pickup_Allowed_Flag
    }

    Dim_Delivery_Status {
        int Delivery_Status_Key PK
        varchar_50 Status_Composite_Code
        varchar_25 Attempt_Outcome
        varchar_40 Attempt_Status_Category
        varchar_50 Failure_Reason_Code
        varchar_3 Signature_Required_Flag
        varchar_25 Proof_Of_Delivery_Type
    }

    Dim_Parcel_Type {
        int Parcel_Type_Key PK
        varchar_10 Parcel_Type_Code
        varchar_50 Parcel_Category_Name
        varchar_25 Weight_Class
        decimal_10_2 Max_Volume_Cm3
        varchar_3 Requires_Two_Man_Handling_Flag
        varchar_3 Conveyable_Sorter_Compatible_Flag
    }

    Dim_Shift {
        int Shift_Key PK
        varchar_10 Shift_Code
        varchar_50 Shift_Name
        time Scheduled_Start_Time
        time Scheduled_End_Time
        decimal_4_2 Standard_Shift_Hours
        int Break_Duration_Minutes
        decimal_3_2 Shift_Premium_Multiplier
    }

    %% =========================================================================
    %% FACT TABLES (3 Core Fact Archetypes)
    %% =========================================================================

    Fact_Delivery_Attempt {
        bigint Delivery_Attempt_Key PK
        varchar_36 Attempt_ID
        int Attempt_Date_Key FK
        int SLA_Deadline_Date_Key FK
        int Origin_Hub_Key FK
        int Route_Key FK
        int Rider_Key FK
        int Customer_Key FK
        int Service_Type_Key FK
        int Delivery_Status_Key FK
        int Parcel_Type_Key FK
        varchar_30 Tracking_Number
        int Attempt_Sequence_Number
        timestamp Attempt_Timestamp
        timestamp SLA_Deadline_Timestamp
        decimal_10_2 Delivery_Fee_Amount
        decimal_10_2 Estimated_Labor_Cost
        decimal_10_2 Estimated_Fuel_Cost
        decimal_10_2 Net_Margin_Amount
        decimal_6_2 Attempt_Duration_Minutes
        decimal_6_2 Package_Weight_Kg
        int ETL_Batch_ID
        timestamp Created_Timestamp
    }

    Fact_Daily_Hub_Backlog {
        bigint Hub_Backlog_Key PK
        int Snapshot_Date_Key FK
        int Hub_Key FK
        int Parcel_Type_Key FK
        varchar_30 Backlog_Status_Code
        int Backlog_Parcel_Count
        decimal_10_2 Total_Dwell_Hours
        decimal_6_2 Max_Dwell_Hours
        int Daily_Inflow_Count
        int Daily_Outflow_Count
        int ETL_Batch_ID
        timestamp Created_Timestamp
    }

    Fact_Rider_Route_Assignment {
        bigint Assignment_Key PK
        int Assignment_Date_Key FK
        int Rider_Key FK
        int Route_Key FK
        int Hub_Key FK
        int Shift_Key FK
        int ETL_Batch_ID
        timestamp Created_Timestamp
    }
